# Host ports and local database credentials
API_PORT=8080
POSTGRES_PORT=5432
POSTGRES_DB=xingshe
POSTGRES_USER=xingshe
POSTGRES_PASSWORD=change-me-for-local-development
REDIS_PORT=6379

# Generate a unique value before authentication work starts.
JWT_SECRET=replace-with-at-least-32-random-characters

# Optional until email login is implemented. Keep real credentials in .env only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Mobile runtime configuration. Never commit the real AMap key.
MOBILE_API_BASE_URL=http://10.0.2.2:8080/api/v1
AMAP_ANDROID_KEY=

# Use these mirrors when the official Go endpoints are unreachable.
GOPROXY=https://goproxy.cn,direct
GOSUMDB=sum.golang.google.cn
