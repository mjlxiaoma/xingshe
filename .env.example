# Host ports and local database credentials
APP_ENV=development
API_PORT=8080
POSTGRES_PORT=5432
POSTGRES_DB=xingshe
POSTGRES_USER=xingshe
POSTGRES_PASSWORD=change-me-for-local-development
REDIS_PORT=6379

# Used when the API and migration command run directly on the host.
DATABASE_URL=postgres://xingshe:change-me-for-local-development@127.0.0.1:5432/xingshe?sslmode=disable
REDIS_ADDR=127.0.0.1:6379
MIGRATIONS_URL=file://migrations

# Required by the API. Generate a unique value before starting it.
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ACCESS_TTL=2h
JWT_REFRESH_TTL=720h

# Optional in development. Configured values use implicit TLS; keep real credentials in .env only.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Public support address shown in privacy and external deletion instructions.
PRIVACY_CONTACT_EMAIL=privacy@example.com

# Mobile runtime configuration. Never commit the real AMap key.
MOBILE_API_BASE_URL=http://10.0.2.2:8080/api/v1
AMAP_ANDROID_KEY=

# Use these mirrors when the official Go endpoints are unreachable.
GOPROXY=https://goproxy.cn,direct
GOSUMDB=sum.golang.google.cn
